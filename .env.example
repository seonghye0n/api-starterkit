# 복사해서 .env로 사용하세요: cp .env.example .env
DB_USERNAME=app
DB_PASSWORD=app1234
DB_ROOT_PASSWORD=root1234

# 최소 32바이트 이상 권장 (HS256 서명 키)
JWT_SECRET=please-change-this-to-a-random-32-byte-or-longer-secret-value

# Google OAuth2 콘솔에서 발급 (redirect URI: http://localhost:8080/login/oauth2/code/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:3000
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/redirect
